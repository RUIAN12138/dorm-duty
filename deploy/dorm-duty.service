[Unit]
Description=Dorm duty web and API
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/opt/dorm-duty/current
ExecStart=/usr/bin/node /opt/dorm-duty/current/scripts/local-server.mjs
DynamicUser=yes
User=dorm-duty
StateDirectory=dorm-duty
StateDirectoryMode=0700
Environment=DORM_DEPLOYMENT=server
Environment=DORM_LOCAL_HOST=127.0.0.1
Environment=DORM_LOCAL_PORT=8086
Environment=DORM_LOCAL_DATABASE=/var/lib/dorm-duty/dorm.sqlite
Environment=DORM_WEB_BASE=/dorm-duty/
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=multi-user.target
