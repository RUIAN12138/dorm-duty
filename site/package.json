{
  "name": "lundao-cloudflare-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bash scripts/build.sh",
    "validate": "node scripts/validate-artifact.mjs",
    "db:generate": "drizzle-kit generate",
    "cloud:check": "node scripts/cloudflare.mjs check",
    "cloud:dry-run": "node scripts/cloudflare.mjs dry-run",
    "cloud:deploy": "node scripts/cloudflare.mjs deploy --public",
    "pages:build": "node scripts/build-pages.mjs",
    "pages:deploy": "node scripts/retired-deployment.mjs"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "esbuild": "0.25.12",
    "ical.js": "2.2.1"
  },
  "dependencies": {
    "nodemailer": "10.1.2",
    "web-push": "3.6.7"
  }
}
